# All VITE_ values are public and embedded at BUILD time, never runtime secrets.
VITE_TELEMETRY_ENABLED=false
VITE_POSTHOG_KEY=
# Use the ingestion host shown in your PostHog project (US or EU).
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_TELEMETRY_ENVIRONMENT=production
VITE_APP_RELEASE=local
# Only for intentional local testing, preferably in a separate PostHog project.
VITE_TELEMETRY_ALLOW_DEV=false
